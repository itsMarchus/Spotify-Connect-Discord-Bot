# ====================================================
# Discord Voice Bot Configuration
# ====================================================
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here
VOICE_CHANNEL_ID=your_voice_channel_id_here

# ====================================================
# Audio Capture Configuration
# ====================================================
# DirectShow recording device name (matches VB-CABLE Output)
# Run "node bot.js --list-devices" (or "run-bot.exe --list-devices") to view available devices
AUDIO_DEVICE_NAME=CABLE Output (VB-Audio Virtual Cable)
