# Discord Application Configuration
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Audio Pipeline Configuration
# Options: "cable" (recommended - Spotify Desktop + VB-CABLE) or "librespot" (legacy Connect endpoint)
AUDIO_MODE=cable

# Virtual Audio Device Name (for "cable" mode)
# Run "node bot.js --list-devices" (or "run-bot.exe --list-devices") to view available devices
AUDIO_DEVICE_NAME=CABLE Output (VB-Audio Virtual Cable)

# Legacy Librespot Settings (Only used if AUDIO_MODE=librespot)
SPOTIFY_DEVICE_NAME=Discord Bot Speaker
SPOTIFY_DEVICE_TYPE=computer
SPOTIFY_BITRATE=160
