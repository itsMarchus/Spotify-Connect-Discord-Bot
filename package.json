{
  "name": "spotify-connect-discord-bot",
  "version": "2.0.0",
  "description": "Spotify Connect receiver for Discord voice channels",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "build:win": "pkg bot.js --targets node22-win-x64 --output run-bot.exe",
    "build:linux": "pkg bot.js --targets node22-linux-x64 --output run-bot"
  },
  "pkg": {
    "assets": [
      "node_modules/opusscript/**/*",
      "node_modules/prism-media/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.3"
  }
}
